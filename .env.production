# Production Environment Variables
# Backend API URL is hidden from frontend code
# Only accessible via VITE_API_URL environment variable in Render dashboard

NODE_ENV=production
PORT=3000

# Database (set in Render dashboard, not in code)
DATABASE_URL=***HIDDEN***

# Neo4j (set in Render dashboard, not in code)
NEO4J_URI=***HIDDEN***
NEO4J_USER=***HIDDEN***
NEO4J_PASSWORD=***HIDDEN***

# Frontend should use VITE_API_URL environment variable
# This is set in Render Static Site settings, not committed to git

# API Keys (set in Render dashboard only)
SHODAN_API_KEY=***HIDDEN***
HUNTER_API_KEY=***HIDDEN***

# Security Headers
CORS_ORIGIN=***HIDDEN***
